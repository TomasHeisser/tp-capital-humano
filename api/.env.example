# Copiar este archivo como api/.env y completar los valores (el .env no se sube al repo).

# Clave de la API de Gemini para "Generar con IA". Si queda vacia se usa el asistente simulado.
GEMINI_API_KEY=

# Secreto para firmar los tokens JWT. Si queda vacio se usa el de desarrollo.
JWT_SECRET=

# Para forzar el asistente simulado aunque haya clave: IA_PROVEEDOR=simulado
IA_PROVEEDOR=gemini
